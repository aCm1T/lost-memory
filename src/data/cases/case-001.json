    {
      "characterId": "char-zhou-cheng",
      "topics": [
        {
          "id": "topic-zhou-relation",
          "question": "你和苏晚是什么关系？",
          "answer": "搭档。这两年商业单都一起接，她负责拍摄，我负责谈客户。今晚我只是来还一只镜头。",
          "unlockConditions": [],
          "revealsClues": [],
          "setsFlags": []
        },
        {
          "id": "topic-zhou-arrival",
          "question": "你今晚什么时候到的酒店？",
          "answer": "大概十点多一点吧。我在大堂等她下来，谁知道她一直不回消息。",
          "unlockConditions": [],
          "revealsClues": [],
          "setsFlags": []
        },
        {
          "id": "topic-zhou-alibi",
          "question": "案发时段你在哪里？",
          "answer": "我一直待在大堂。你可以问前台，我还问过宵夜。",
          "unlockConditions": [],
          "revealsClues": [],
          "setsFlags": ["flag_zhou_alibi_claimed"]
        },
        {
